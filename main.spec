# Nombre de tu juego
title = RPG Legends Beta

# Nombre del paquete (en minúsculas, sin espacios)
package.name = rpglegends

# Tu dominio o nombre de desarrollador
package.domain = com.miempresa

# Extensión de los archivos a incluir
source.include_exts = py,png,jpg,jpeg,ttf,json,wav,mp3

# Directorios de recursos a incluir
source.include_dirs = assets, data, entities, maps, systems

# Requisitos de librerías Python
requirements = python3, pygame

# Orientación del celular (landscape = horizontal, portrait = vertical)
orientation = landscape